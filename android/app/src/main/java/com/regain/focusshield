package com.regain.focusshield

import android.content.Context
import android.content.Intent
import android.net.VpnService
import android.util.Log

/**
 * BlockingService is the bridge between the React web layer and the native
 * [FocusVpnService]. The Capacitor web app calls into this helper to start
 * and stop the Emergency Focus Shield.
 *
 * On start it requests VPN consent (if needed) and launches the VPN service
 * with the list of hostnames to block. On stop it tears the tunnel down.
 */
class BlockingService(private val context: Context) {

    companion object {
        private const val TAG = "BlockingService"
        const val VPN_REQUEST_CODE = 7001
    }

    /**
     * Starts the Focus Shield VPN, blocking the given hostnames at the
     * network level.
     *
     * @return true if the VPN was started (or consent prompt shown),
     *         false if VPN consent was denied.
     */
    fun startShield(blockedHosts: List<String>): Boolean {
        val prepareIntent = VpnService.prepare(context)
        if (prepareIntent != null) {
            // Consent needed — caller (MainActivity) must launch the intent
            // and call startShieldAgain after onActivityResult
            Log.i(TAG, "VPN consent required")
            return false
        }
        Log.i(TAG, "Starting shield with ${blockedHosts.size} hosts")
        FocusVpnService.start(context, blockedHosts)
        return true
    }

    /**
     * Stops the Focus Shield VPN tunnel.
     */
    fun stopShield() {
        Log.i(TAG, "Stopping shield")
        FocusVpnService.stop(context)
    }

    /**
     * Returns the consent intent if VPN consent is needed, or null if the
     * app already has consent. The caller should launch the returned intent
     * with [VPN_REQUEST_CODE].
     */
    fun getConsentIntent(): Intent? {
        return VpnService.prepare(context)
    }
}

